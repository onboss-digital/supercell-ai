generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BusinessManager {
  id          String      @id @default(uuid())
  name        String
  bmId        String      @unique
  accessToken String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  adAccounts  AdAccount[]
}

model AdAccount {
  id        String          @id @default(uuid())
  name      String
  actId     String          @unique
  status    String          @default("ACTIVE")
  bmId      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  bm        BusinessManager @relation(fields: [bmId], references: [id])
}

model Sale {
  id              Int       @id @default(autoincrement())
  telefoneCliente String?
  nomeCliente     String?
  vendedor        String?
  produto         String?
  statusVenda     String?
  lucro           Decimal?  @db.Decimal(10, 2)
  valorTotal      Decimal?  @db.Decimal(10, 2)
  createdAt       DateTime? @default(now())
  canalVenda      String?
  tipoVenda       String?
}

model AiConfig {
  id                   String   @id @default("default")
  systemPrompt         String
  model                String   @default("gpt-4o")
  updatedAt            DateTime @updatedAt
  voiceId              String?
  markupPerUnit        Float?   @default(0)
  targetConversionRate Float?   @default(0)
  cpaThreshold         Float?   @default(0)
  ctrThreshold         Float?   @default(0)
  weeklyMessageGoal    Int?     @default(0)
}

model DailyInsight {
  id             Int       @id @default(autoincrement())
  date           DateTime  @unique @default(dbgenerated("CURRENT_DATE")) @db.Date
  content        String
  metricsSummary Json?
  createdAt      DateTime? @default(now()) @db.Timestamp(6)
}

model CustomTemplate {
  id        String   @id @default(uuid())
  name      String
  metricIds Json
  funnelIds Json
  icon      String   @default("auto_awesome")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyProfile {
  id        String    @id
  name      String?   @default("Supercell AI Store")
  timezone  String?   @default("UTC-3")
  currency  String?   @default("BRL")
  updatedAt DateTime? @default(now()) @db.Timestamp(6)
  logoUrl   String?
}

model Invoice {
  id        Int       @id @default(autoincrement())
  date      String
  value     String
  status    String?   @default("Pago")
  createdAt DateTime? @default(now()) @db.Timestamp(6)
}

model OnboardingState {
  id           String    @id
  is_dismissed Boolean?  @default(false)
  createdAt    DateTime? @default(now()) @db.Timestamp(6)
  updatedAt    DateTime? @default(now()) @db.Timestamp(6)
}

model SalesGoal {
  id             String    @id
  dailySalesGoal Int?      @default(0)
  dailyLeadsGoal Int?      @default(0)
  updatedAt      DateTime? @default(now()) @db.Timestamp(6)
}

model SecuritySettings {
  id                 String    @id
  twoFactorEnabled   Boolean?  @default(false)
  lastPasswordChange DateTime? @default(now()) @db.Timestamp(6)
}

model TeamMember {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  email     String    @unique
  role      String?   @default("Analista")
  createdAt DateTime? @default(now()) @db.Timestamp(6)
}

model CustomGoal {
  id        String   @id @default(uuid())
  name      String
  value     String
  unit      String?
  period    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KnowledgeFile {
  id        String   @id @default(uuid())
  fileName  String
  content   String
  fileType  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        Int       @id @default(autoincrement())
  type      String
  title     String
  message   String
  read      Boolean?  @default(false)
  createdAt DateTime? @default(now()) @db.Timestamp(6)
}

model NotificationConfig {
  id              String    @id
  topic           String
  url             String?   @default("https://ntfy.sh")
  enabled         Boolean?  @default(true)
  dailyReportTime String?   @default("19:00")
  updatedAt       DateTime? @default(now()) @db.Timestamp(6)
}

model JarvisMessage {
  id        String   @id @default(uuid())
  role      String
  content   String   @db.Text
  createdAt DateTime @default(now())
}
